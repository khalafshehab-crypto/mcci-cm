rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isManager() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/employees/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'مدير إدارة' || 
         get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.role == 'رئيس قسم' || 
         get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.orgLevel1 != null);
    }
    
    function isSysAdmin() { 
       return isSignedIn() && (request.auth.token.email == 'khalafshehab@gmail.com');
    }

    match /employees/{userId} {
      allow read: if true;
      allow create: if isSysAdmin() || isManager() || (
        isSignedIn() && incoming().email == request.auth.token.email
      );
      allow update: if isSysAdmin() || isManager() || (
        isSignedIn() && resource.data.email == request.auth.token.email &&
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'roleAr', 'orgLevel1', 'orgLevel2', 'active', 'loginEnabled'])
      );
      allow delete: if isSysAdmin() || (
        isSignedIn() && resource.data.email == request.auth.token.email
      );
    }

    match /committees/{committeeId} {
      allow read: if true;
      allow create: if (isManager() || isSysAdmin()) && isValidId(committeeId);
      allow update: if isManager() || isSysAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/employees/$(request.auth.uid))
      );
      allow delete: if isManager() || isSysAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /tasks/{taskId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isManager() || isSysAdmin();
    }

    match /recommendations/{recId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(recId);
      allow delete: if isManager() || isSysAdmin();
    }
    
    match /members/{memberId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(memberId);
      allow delete: if isManager() || isSysAdmin();
    }

    match /templates/{templateId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(templateId);
      allow delete: if isSysAdmin() || isManager() || isSignedIn();
    }

    match /reports/{reportId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(reportId);
      allow delete: if isSysAdmin() || isManager();
    }

    match /kpis/{kpiId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(kpiId);
      allow delete: if isSysAdmin() || isManager();
    }

    match /system_logs/{logId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(logId);
      allow update: if false; allow delete: if isSysAdmin();
    }

    match /approved_emails/{emailId} {
      allow read: if true; 
      allow create, update, delete: if isSysAdmin() || isManager();
    }

    match /join_requests/{reqId} {
      allow read, create: if true; 
      allow update, delete: if isSysAdmin() || isManager();
    }

    match /delegations/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /centers_events/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /centers_list/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /affiliates_events/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /affiliates_list/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /assistant_sec_gen_events/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /assistant_sec_gen_list/{docId} { allow read: if true; allow write: if isSignedIn(); }
    
    match /employee_tokens/{emailId} { allow read: if true; allow write: if isSignedIn(); }
    match /org_structure/{docId} { allow read: if true; allow write: if isSignedIn(); }
    match /system_settings/{settingId} { allow read: if true; allow write: if isSignedIn(); }
    match /system_alerts/{alertId} { allow read: if true; allow write: if isSignedIn(); }
  }
}
